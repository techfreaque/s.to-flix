{
  "name": "s.to flix",
  "version": "1.6.2",
  "manifest_version": 3,
  "description": "Use this extension to verify if your Sovendus integration is setup properly",
  "background": {
    "scripts": [
      "page-scripts/service-worker.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "page-scripts/iframe-script.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "scripting",
    "webNavigation",
    "storage"
  ],
  "action": {
    "default_popup": "extension-pop-up/extension-pop-up.html"
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "web_accessible_resources": [
    {
      "resources": [
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "icons": {
    "128": "s.to.png"
  }
}